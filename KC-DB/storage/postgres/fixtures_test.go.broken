	err := f.db.QueryRowContext(f.ctx, query,
		session.GatewayID, session.TenantID, session.SessionID,
		session.ConnectionID, session.RemoteAddr, session.ProtocolVersion,
		session.Status, session.StartedAt, session.MessagesReceived,
		session.MessagesSent, session.BytesReceived, session.BytesSent,
		session.Metadata).
		Scan(&id, &createdAt)
	require.NoError(f.t, err)

	session.ID = id
	session.CreatedAt = createdAt
	return session
}

