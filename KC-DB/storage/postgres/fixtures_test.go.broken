		ConnectionID:     &connectionID,
		RemoteAddr:       &remoteAddr,
		ProtocolVersion:  &protocolVersion,
		Status:           "active",
		StartedAt:        time.Now(),
		LastPingAt:       nil,
		MessagesReceived: 0,
		MessagesSent:     0,
		BytesReceived:    0,
		BytesSent:        0,
