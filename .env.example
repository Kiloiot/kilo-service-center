# KiloCenter — Docker Compose environment
# Copy this file to .env and adjust before running:
#   docker compose run --rm certgen
#   docker compose up --build -d

# ─── Database credentials ─────────────────────────────────────────────────────
KILOCENTER_POSTGRESQL_USERNAME=kilocenter
KILOCENTER_POSTGRESQL_PASSWORD=changeme        # change before any shared deployment
KILOCENTER_POSTGRESQL_DATABASE=kilocenter

# Key-material master key (REQUIRED): all endpoint/session/message keys are
# encrypted at rest with it; services fatal without it. 64 hex chars or
# base64 -> 32 bytes. Generate with: openssl rand -hex 32
KILOCENTER_MASTER_KEY=

# Internal peer secret (REQUIRED): KC-Gateway, KC-Core and KC-Identity reach
# each other over the Docker network and trust each other's identity headers
# only with this shared secret; services refuse to start without it. At least
# 32 characters. Generate with: openssl rand -hex 32
KILOCENTER_INTERNAL_PEER_SECRET=

# ─── Logging ──────────────────────────────────────────────────────────────────
KILOCENTER_LOG_LEVEL=info                      # debug | info | warn | error

# ─── TLS certificates ──────────────────────────────────────────────────────────
# Server name for TLS certificate CN/SAN (defaults to localhost).
# Set to your FQDN for external BSSCI/SCACI access (e.g., bssci.example.com).
# KILOCENTER_TLS_SERVER_NAME=localhost

# File ownership (Linux): if generated files are owned by root, rerun with UID=$(id -u) GID=$(id -g) prefixed.
# UID=$(id -u)
# GID=$(id -g)
