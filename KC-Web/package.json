{
  "name": "kc-web",
  "private": true,
  "version": "0.0.0",
  "description": "KiloCenter MIOTY Service Center — web management interface",
  "homepage": "https://kiloiot.io/mioty-service-center/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kiloiot/kilo-service-center.git"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Tim Kravchunovsky",
  "type": "module",
  "scripts": {
    "predev": "bun run grpc:sync",
    "dev": "vite",
    "prebuild": "bun run grpc:sync",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "postinstall": "bun run grpc:sync",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "grpc:setup": "mkdir -p node_modules/@kilocenter/grpc-stubs && node -e \"const fs=require('fs'),d='node_modules/@kilocenter/grpc-stubs',s='src/services/grpc';['identity_pb.js','identity_pb.d.ts','core_pb.js','core_pb.d.ts','identity_pb_service.js','identity_pb_service.d.ts','core_pb_service.js','core_pb_service.d.ts','package.json'].forEach(f=>{try{fs.copyFileSync(s+'/'+f,d+'/'+f)}catch(e){console.warn('skip',f)}})\"",
    "grpc:generate": "mkdir -p src/services/grpc && grpc_tools_node_protoc --plugin=protoc-gen-js4=node_modules/.bin/protoc-gen-js --js4_out=import_style=commonjs,binary:src/services/grpc --grpc_out=grpc_js:src/services/grpc --plugin=protoc-gen-grpc=node_modules/.bin/grpc_tools_node_protoc_plugin --plugin=protoc-gen-ts=node_modules/.bin/protoc-gen-ts --ts_out=service=grpc-web:src/services/grpc -I ../KC-Core/api/proto -I /usr/local/include ../KC-Core/api/proto/core.proto ../KC-Core/api/proto/identity.proto && rm -f src/services/grpc/*_grpc_pb.js",
    "grpc:sync": "bun run grpc:generate && bun run grpc:setup",
    "grpc:verify": "TMPD=$(mktemp -d) && trap 'rm -rf \"$TMPD\"' EXIT && mkdir -p $TMPD && grpc_tools_node_protoc --plugin=protoc-gen-js4=node_modules/.bin/protoc-gen-js --js4_out=import_style=commonjs,binary:$TMPD --grpc_out=grpc_js:$TMPD --plugin=protoc-gen-grpc=node_modules/.bin/grpc_tools_node_protoc_plugin --plugin=protoc-gen-ts=node_modules/.bin/protoc-gen-ts --ts_out=service=grpc-web:$TMPD -I ../KC-Core/api/proto -I /usr/local/include ../KC-Core/api/proto/core.proto ../KC-Core/api/proto/identity.proto && rm -f $TMPD/*_grpc_pb.js && for f in core_pb.js core_pb.d.ts core_pb_service.js core_pb_service.d.ts identity_pb.js identity_pb.d.ts identity_pb_service.js identity_pb_service.d.ts ; do cmp -s \"src/services/grpc/$f\" \"$TMPD/$f\" || exit 1; done"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@improbable-eng/grpc-web": "^0.15.0",
    "@mui/icons-material": "^9",
    "@mui/material": "^9",
    "@tanstack/react-query": "^5.100.9",
    "date-fns": "^4.1.0",
    "google-protobuf": "^4",
    "leaflet": "^1.9.4",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/react-query-devtools": "^5.100.9",
    "@types/google-protobuf": "^3.15.12",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.18.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.6.0",
    "grpc-tools": "^1.13.1",
    "protoc-gen-js": "^4.0.3",
    "ts-protoc-gen": "^0.15.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^8.0.11"
  },
  "trustedDependencies": [
    "grpc-tools",
    "protoc-gen-js"
  ]
}
