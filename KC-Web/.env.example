# KC-Web Environment Configuration Example
# Copy this file to .env.development and customize for your setup

# gRPC-web URL (empty uses Vite proxy from vite.config.ts)
# Leave empty for development (uses proxy to localhost:9090)
# Set to KC-Core gRPC-web endpoint for production
VITE_GRPC_URL=

# Organization ID for development/testing (UUID format)
# Community edition: Use this default value
# Cloud edition: Extracted from JWT automatically
VITE_DEV_ORG_ID=00000000-0000-0000-0000-000000000001

# User ID for development/testing (UUID format)
VITE_DEV_USER_ID=00000000-0000-0000-0000-000000000001

# External IdP organization claim path (optional)
# Default: urn:zitadel:iam:org:project:id (external IdP default)
# Override for other IdPs (e.g., Auth0, Okta, Keycloak)
# VITE_EXTERNAL_ORG_CLAIM_PATH=urn:your-idp:org:id
