# KiloCenter Configuration
# Copy this file to .env and update values as needed

# General Configuration
KILOCENTER_GENERAL_ENVIRONMENT=development
KILOCENTER_GENERAL_LOG_LEVEL=info
KILOCENTER_GENERAL_LOG_FORMAT=json
KILOCENTER_GENERAL_SERVER_NAME=KiloCenter-Dev
KILOCENTER_GENERAL_HEALTH_CHECK_PORT=8081

# PostgreSQL Configuration
KILOCENTER_POSTGRES_HOST=localhost
KILOCENTER_POSTGRES_PORT=5432
KILOCENTER_POSTGRES_DATABASE=kilocenter
KILOCENTER_POSTGRES_USER=kilocenter
KILOCENTER_POSTGRES_PASSWORD=changeme
KILOCENTER_POSTGRES_SSL_MODE=disable
KILOCENTER_POSTGRES_MAX_CONNECTIONS=25
KILOCENTER_POSTGRES_MAX_IDLE_CONNECTIONS=5
KILOCENTER_POSTGRES_CONNECTION_MAX_LIFETIME=5m

# MQTT Configuration
KILOCENTER_MQTT_ENABLED=true
KILOCENTER_MQTT_BROKER_URL=tcp://localhost:1883
KILOCENTER_MQTT_CLIENT_ID=kilocenter-core
KILOCENTER_MQTT_USERNAME=admin
KILOCENTER_MQTT_PASSWORD=kilocenter
KILOCENTER_MQTT_TOPIC_PREFIX=mioty
KILOCENTER_MQTT_QOS=1
KILOCENTER_MQTT_RETAIN=false
KILOCENTER_MQTT_CLEAN_SESSION=true
KILOCENTER_MQTT_AUTO_RECONNECT=true
KILOCENTER_MQTT_RECONNECT_INTERVAL=10s
KILOCENTER_MQTT_KEEP_ALIVE=60s
KILOCENTER_MQTT_PING_TIMEOUT=10s
KILOCENTER_MQTT_WRITE_TIMEOUT=10s
KILOCENTER_MQTT_TLS_ENABLED=false

# Protocol Configuration
KILOCENTER_PROTOCOL_BSCI_PORT=5000
KILOCENTER_PROTOCOL_BSCI_TLS_ENABLED=true
KILOCENTER_PROTOCOL_BSCI_CERT_FILE=certs/server.crt
KILOCENTER_PROTOCOL_BSCI_KEY_FILE=certs/server.key
KILOCENTER_PROTOCOL_BSCI_CA_FILE=certs/ca.crt
KILOCENTER_PROTOCOL_SCACI_PORT=5001
KILOCENTER_PROTOCOL_SCACI_TLS_ENABLED=true

# Storage Configuration
KILOCENTER_STORAGE_MESSAGE_RETENTION_DAYS=90
KILOCENTER_STORAGE_ARCHIVAL_ENABLED=true
KILOCENTER_STORAGE_ARCHIVAL_BATCH_SIZE=1000
KILOCENTER_STORAGE_ARCHIVAL_INTERVAL=24h

# gRPC Configuration
KILOCENTER_GRPC_ENABLED=true
KILOCENTER_GRPC_PORT=50051
KILOCENTER_GRPC_TLS_ENABLED=false
KILOCENTER_GRPC_MAX_RECV_MSG_SIZE=4194304
KILOCENTER_GRPC_MAX_SEND_MSG_SIZE=4194304
KILOCENTER_GRPC_KEEP_ALIVE_TIME=10s
KILOCENTER_GRPC_KEEP_ALIVE_TIMEOUT=5s
